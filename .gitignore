# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker
.dockerignore
.playwright-mcp

# OMC tooling
.omc/
.superpowers/

# Temp / scratch
.tmp/

# Isolated dev tools (Python/ npm scripts) — see tool-isolation skill.
.tool/

# Cloned reference repositories (nested git repos / dangling gitlinks).
# These must never be committed — see git-repo-cleanup skill.
.claude/repo/

# Lint & GH CLI output dumped at repo root
eslint-report.json
run.json
run-help.json
.gstack/
# generated by replay script

# husky v9 internals — generated locally by `prepare` script on install.
# Track .husky/pre-commit etc., but not the .husky/_ forwarder directory.
.husky/_/

# Vite dev-server timestamp temp files (regenerated each run)
apps/showcase/vite.config.ts.timestamp-*.mjs

# nginx location blocks generated from component.config.ts `api` fields.
# Build artifact — regenerated by scripts/gen-nginx.mjs in the Docker builder
# stage. Committing it would create a second source of truth that can silently
# drift from the component configs it is derived from.
nginx/api-locations/
