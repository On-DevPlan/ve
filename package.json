{
  "name": "@style-library/ve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @style-library/showcase dev",
    "build": "pnpm --filter @style-library/showcase build",
    "preview": "pnpm --filter @style-library/showcase preview",
    "gen:nginx": "pnpm --filter @style-library/showcase gen:nginx",
    "lint": "eslint . --max-warnings=0 --format=json --output-file=eslint-report.json",
    "lint:fix": "node scripts/lint-fix.mjs",
    "lint:summary": "node scripts/lint-summary.mjs --self",
    "lint:summary:strict": "node scripts/lint-summary.mjs --self --strict",
    "lint:loop": "node scripts/lint-loop.mjs",
    "test": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,vue}": "node_modules/.bin/eslint --cache --cache-location .eslintcache --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
